{
  "version": 2,
  "headers": [
    {
      "source": "/preview.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, immutable" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/preview.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
